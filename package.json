{
  "name": "logs-ingestor",
  "version": "1.0.0",
  "description": "Ingest JSON logs into PostgreSQL and query them through a web form",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:setup": "psql -f schema.sql",
    "seed": "curl -s -X POST http://localhost:3000/upload -H 'Content-Type: application/json' --data @sample_logs.json"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  }
}
